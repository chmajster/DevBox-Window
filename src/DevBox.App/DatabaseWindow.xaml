<Window x:Class="DevBox.App.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · Databases" Height="680" Width="980" MinHeight="540" MinWidth="820"
        Background="#F4F6F9" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E8ECF2"/></Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="Database Manager" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="MySQL databases, backup and restore." Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Foreground="#6B7280"/><Button Content="Refresh" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="HOST" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="PORT" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="USER" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="PASSWORD" FontSize="10" Foreground="#9CA3AF"/><PasswordBox x:Name="PasswordInput" Padding="8" PasswordChanged="PasswordInput_OnPasswordChanged"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="CREATE DATABASE" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding NewDatabaseName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,6"/><Button Content="Create" Style="{StaticResource Primary}" Command="{Binding CreateDatabaseCommand}" HorizontalAlignment="Left"/></StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="Backup selected" Command="{Binding BackupCommand}"/><Button Content="Restore into selected" Command="{Binding RestoreCommand}"/></StackPanel>
                    <TextBlock Text="Select a database on the right, then use Backup or Restore." Foreground="#6B7280" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DATABASES" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" BorderThickness="0" FontSize="14"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
