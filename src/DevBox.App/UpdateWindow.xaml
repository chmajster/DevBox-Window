<Window x:Class="DevBox.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · Updates" Height="390" Width="680" MinHeight="340" MinWidth="580"
        Background="#F4F6F9" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E8ECF2"/></Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Application Updates" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Checks stable releases from the DevBox GitHub repository." Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CURRENT VERSION" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding CurrentVersion}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="LATEST VERSION" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding LatestVersion}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,22,0,8" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="{Binding ReleaseUrl}" Foreground="#2563EB" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Open release" Command="{Binding OpenReleaseCommand}"/><Button Content="Check for updates" Style="{StaticResource Primary}" Command="{Binding CheckCommand}"/></StackPanel>
    </Grid>
</Window>
