<Window x:Class="DevBox.App.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · Project Manager" Height="820" Width="1180" MinHeight="640" MinWidth="900"
        Background="#F4F6F9" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E8ECF2"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Project Manager" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Create, import, diagnose and operate local projects." Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Refresh" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,14">
            <TextBlock Text="Project commands use predefined presets. Project paths and managed service executables remain constrained to the DevBox root." Foreground="#1E40AF" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Create / Import">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Create from stack profile" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="PROFILE" FontSize="10" Foreground="#9CA3AF"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Padding="7"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="PROJECT NAME" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="DOMAIN (OPTIONAL)" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding ProjectDomain, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                                    <Button Grid.Column="3" Content="Create project" VerticalAlignment="Bottom" Style="{StaticResource Primary}" Command="{Binding CreateProjectCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedProfile.Description}" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Import existing project" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="SOURCE DIRECTORY" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                                    <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Command="{Binding BrowseImportCommand}"/>
                                    <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="PROJECT NAME" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding ImportName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></StackPanel>
                                    <Button Grid.Column="3" Content="Import" VerticalAlignment="Bottom" Style="{StaticResource Primary}" Command="{Binding ImportProjectCommand}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Copy into DevBox www" IsChecked="{Binding CopyImport}" VerticalAlignment="Center"/>
                                    <Button Content="Detect stack" Command="{Binding DetectImportCommand}" Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DetectionSummary}" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Projects">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Open site" Style="{StaticResource Primary}" Command="{Binding OpenSiteCommand}"/>
                                <Button Content="Folder" Command="{Binding OpenProjectCommand}"/>
                                <Button Content="Health" Command="{Binding CheckHealthCommand}"/>
                                <Button Content="Repair" Command="{Binding RepairCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Domain}" Foreground="#2563EB"/>
                                            <TextBlock Text="{Binding Kind}" Foreground="#6B7280" FontSize="11"/>
                                            <TextBlock Text="{Binding ProjectRoot}" Foreground="#9CA3AF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding HealthSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding HealthChecks}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding State}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Details}" TextWrapping="Wrap" Foreground="#6B7280"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="270" ItemsSource="{Binding ProjectCommands}" SelectedItem="{Binding SelectedCommand}" DisplayMemberPath="DisplayName"/>
                                    <Button Content="Run preset" Style="{StaticResource Primary}" Command="{Binding RunCommand}"/>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding CommandOutput}" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Services / Xdebug">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Register Mailpit" Command="{Binding AddMailpitCommand}"/>
                                <Button Content="Register Redis" Command="{Binding AddRedisCommand}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Start" Style="{StaticResource Primary}" Command="{Binding StartManagedServiceCommand}"/>
                                <Button Content="Restart" Command="{Binding RestartManagedServiceCommand}"/>
                                <Button Content="Stop" Command="{Binding StopManagedServiceCommand}"/>
                                <Button Content="Enable / Disable" Command="{Binding ToggleManagedServiceCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding ManagedServices}" SelectedItem="{Binding SelectedManagedService}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Runtime}" FontSize="11" Foreground="#6B7280"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding State}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Port}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Manifest.Enabled}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Xdebug" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding XdebugStatus}" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <CheckBox Content="Enable Xdebug" IsChecked="{Binding XdebugEnabled}" Margin="0,0,0,10"/>
                            <TextBlock Text="MODE" FontSize="10" Foreground="#9CA3AF"/>
                            <TextBox Text="{Binding XdebugMode}" Padding="8" Margin="0,0,0,8"/>
                            <TextBlock Text="CLIENT PORT" FontSize="10" Foreground="#9CA3AF"/>
                            <TextBox Text="{Binding XdebugPort}" Padding="8" Margin="0,0,0,8"/>
                            <TextBlock Text="START WITH REQUEST" FontSize="10" Foreground="#9CA3AF"/>
                            <ComboBox Text="{Binding XdebugStartWithRequest}" IsEditable="True" Padding="7" Margin="0,0,0,10">
                                <ComboBoxItem Content="trigger"/><ComboBoxItem Content="yes"/><ComboBoxItem Content="no"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Reload" Command="{Binding RefreshXdebugCommand}"/>
                                <Button Content="Apply" Style="{StaticResource Primary}" Command="{Binding ApplyXdebugCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
