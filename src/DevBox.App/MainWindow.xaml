<Window x:Class="DevBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox Windows" Height="760" Width="1220" MinHeight="640" MinWidth="980"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E8ECF2"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="DevBox" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,22"/>
                    <Button Content="Dashboard" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <Button Content="Sites" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Sites"/>
                    <Button Content="PHP" Style="{StaticResource SidebarButton}" Click="PhpNav_Click"/>
                    <Button Content="Databases" Style="{StaticResource SidebarButton}" Click="DatabasesNav_Click"/>
                    <Button Content="Runtimes" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Runtimes"/>
                    <Button Content="SSL" Style="{StaticResource SidebarButton}" Click="SslNav_Click"/>
                    <Button Content="ADDONS" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="ADDONS"/>
                    <Button Content="Tools" Style="{StaticResource SidebarButton}" Click="ToolsNav_Click"/>
                    <Button Content="Logs" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs"/>
                    <Button Content="Diagnostics" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"/>
                    <Button Content="Setup" Style="{StaticResource SidebarButton}" Click="SetupNav_Click"/>
                    <Button Content="Updates" Style="{StaticResource SidebarButton}" Click="UpdatesNav_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Settings" Style="{StaticResource SidebarButton}" Click="SettingsNav_Click" Margin="0,0,0,12"/>
                    <TextBlock Text="ROOT" Foreground="#6B7280" FontSize="10"/>
                    <TextBlock Text="{Binding RootPath}" Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid Visibility="{Binding DashboardVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Local development environment" FontSize="27" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="Native Windows processes · Nginx · PHP FastCGI · MySQL" Foreground="#6B7280" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start All" Style="{StaticResource PrimaryButton}" Command="{Binding StartAllCommand}"/>
                        <Button Content="Restart All" Command="{Binding RestartAllCommand}"/>
                        <Button Content="Stop All" Command="{Binding StopAllCommand}"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" Padding="13" Margin="0,0,0,18" CornerRadius="6">
                    <TextBlock Text="Missing runtimes are reported explicitly. DevBox never simulates installed services." Foreground="#9A3412"/>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock Text="{Binding RuntimePath}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="STATUS" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="PORT / PID" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding PortPid}"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="UPTIME" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding Uptime}"/></StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Start" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Restart" Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Stop" Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding SitesVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Sites" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Create local .test projects and generate Nginx vhosts automatically." Foreground="#6B7280" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="SITE NAME" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding NewSiteName, UpdateSourceTrigger=PropertyChanged}" Padding="9"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="DOMAIN (OPTIONAL)" FontSize="10" Foreground="#9CA3AF"/><TextBox Text="{Binding NewSiteDomain, UpdateSourceTrigger=PropertyChanged}" Padding="9"/></StackPanel>
                        <Button Grid.Column="2" Content="Create Site" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" Command="{Binding CreateSiteCommand}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Project" Foreground="#9CA3AF" FontSize="11"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="DOMAIN" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding Domain}" Foreground="#2563EB"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="DOCUMENT ROOT" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding DocumentRoot}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="Open" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Folder" Command="{Binding DataContext.OpenSiteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding RuntimesVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="Runtimes" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Download verified PHP/Nginx packages on demand or manage installed runtime versions." Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel>
                <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="13" Margin="0,0,0,18" CornerRadius="6"><TextBlock Text="Runtime packages are accepted only through the verified runtime lifecycle: HTTPS + pinned SHA-256 + safe extraction." Foreground="#1E40AF" TextWrapping="Wrap"/></Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Runtimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding InstallPath}" TextTrimming="CharacterEllipsis" Foreground="#6B7280"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Download" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanDownload}" Command="{Binding DataContext.DownloadRuntimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Activate" IsEnabled="{Binding CanActivate}" Command="{Binding DataContext.ActivateRuntimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button Content="Remove" IsEnabled="{Binding CanRemove}" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveRuntimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding AddonsVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock Text="ADDONS" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Install, repair, diagnose and remove optional DevBox tools." Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel>
                <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="13" Margin="0,0,0,18" CornerRadius="6"><TextBlock Text="Downloads use pinned SHA-256 verification. UAC is requested only for the narrow hosts-file operation." Foreground="#1E40AF" TextWrapping="Wrap"/></Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Addons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#6B7280" Margin="0,4,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding InstallPath}" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="STATUS" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/><TextBlock Text="{Binding LocalUrl}" FontSize="11" Foreground="#2563EB" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="HEALTH" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding HostStatus}" Margin="0,3,0,0"/><TextBlock Text="{Binding ConfigStatus}" Margin="0,3,0,0"/><TextBlock Text="{Binding PhpStatus}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                                        <WrapPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="270">
                                            <Button Content="{Binding InstallAction}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.InstallAddonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                            <Button Content="Repair" Command="{Binding DataContext.RepairAddonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                            <Button Content="Open" Command="{Binding DataContext.OpenAddonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                            <Button Content="Folder" Command="{Binding DataContext.OpenAddonFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                            <Button Content="Uninstall" Style="{StaticResource DangerButton}" Command="{Binding DataContext.UninstallAddonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                        </WrapPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,15,0,0"><TextBlock Text="REQUIRED PHP EXTENSIONS" FontSize="10" Foreground="#9CA3AF"/><TextBlock Text="{Binding Requirements}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding LogsVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="Logs" FontSize="27" FontWeight="SemiBold"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshLogsCommand}"/><Button Content="Clear" Style="{StaticResource DangerButton}" Command="{Binding ClearLogCommand}"/></StackPanel></Grid>
                <ComboBox Grid.Row="1" ItemsSource="{Binding LogFiles}" SelectedItem="{Binding SelectedLog}" Padding="8" Margin="0,0,0,12"/>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Padding="14"/></Border>
            </Grid>

            <Grid Visibility="{Binding DiagnosticsVisibility}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="Diagnostics" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Filesystem, configuration, runtime and managed-service checks." Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel><Button Content="Run checks" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshDiagnosticsCommand}"/></Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Category}" Foreground="#6B7280"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Status}"/><TextBlock Grid.Column="3" Text="{Binding Details}" TextWrapping="Wrap" Foreground="#6B7280"/></Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>