<Window x:Class="DevBox.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · Settings" Height="430" Width="650" MinHeight="360" MinWidth="560"
        Background="#F4F6F9" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8"/><Setter Property="FontSize" Value="15"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Startup and tray behavior." Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <CheckBox Content="Start DevBox with Windows" IsChecked="{Binding StartWithWindows}"/>
                <TextBlock Text="Uses the current-user Windows Run key. Administrator rights are not required." Foreground="#6B7280" Margin="24,-3,0,8" TextWrapping="Wrap"/>
                <CheckBox Content="Minimize to system tray when the main window is closed" IsChecked="{Binding MinimizeToTray}"/>
                <CheckBox Content="Start Nginx, PHP and MySQL automatically when DevBox starts" IsChecked="{Binding StartServicesAutomatically}"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0" Content="Save settings" Command="{Binding SaveCommand}"/>
    </Grid>
</Window>
