<Window x:Class="DevBox.App.SslWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · Local SSL" Height="650" Width="980" MinHeight="500" MinWidth="820"
        Background="#F4F6F9" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E8ECF2"/></Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="Foreground" Value="#991B1B"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="Local SSL" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Generate per-site certificates, configure Nginx HTTPS and trust certificates for the current Windows user." Foreground="#6B7280" Margin="0,4,0,0"/></StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}"/>
        </Grid>
        <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <TextBlock Text="Trust is limited to the CurrentUser certificate store. DevBox does not run the whole UI as Administrator." Foreground="#9A3412" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Domain}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Name}" Foreground="#6B7280"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding HttpsStatus}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TrustStatus}" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="3" MaxWidth="360">
                                    <Button Content="Enable HTTPS" Style="{StaticResource Primary}" Command="{Binding DataContext.EnableHttpsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Disable" Command="{Binding DataContext.DisableHttpsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Trust" Command="{Binding DataContext.TrustCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Untrust" Style="{StaticResource Danger}" Command="{Binding DataContext.UntrustCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Open HTTPS" Command="{Binding DataContext.OpenHttpsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
