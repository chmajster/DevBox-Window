<Window x:Class="DevBox.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBox · First Run" Height="640" Width="900" MinHeight="520" MinWidth="760"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E8ECF2"/></Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Set up DevBox" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="DevBox checks the local environment and can install only runtime packages that have pinned SHA-256 verification." Foreground="#6B7280" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <TextBlock Text="{Binding Status}" Foreground="#1E40AF" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#6B7280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Install" Style="{StaticResource Primary}" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Install verified runtimes" Style="{StaticResource Primary}" Command="{Binding InstallAllCommand}"/></StackPanel>
            <Button Content="Continue to DevBox" HorizontalAlignment="Right" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
